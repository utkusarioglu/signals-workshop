{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Interpret SuperCollider preset",
      "detail": "Run preset file with sclang",
      "command": "scripts/sclang.sh",
      "args": [
        "--preset",
        "${input:presetName}",
      ],
      "icon": {
        "id": "play",
        "color": "terminal.ansiGreen"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Interpret SuperCollider file",
      "detail": "Run the current file with sclang",
      "command": "scripts/sclang.sh",
      "args": [
        "--file",
        "${file}",
      ],
      "icon": {
        "id": "play",
        "color": "terminal.ansiGreen"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Test Monitor",
      "detail": "Run tests",
      "type": "shell",
      "command": "scripts/test-monitor.sh",
      "icon": {
        "color": "terminal.ansiYellow",
        "id": "beaker"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "close": false
      }
    },
    {
      "label": "Format Notebooks",
      "detail": "Formats ipynb documents - This is needed because run-on-save fails",
      "type": "shell",
      "command": "black --ipynb src/**.ipynb",
      "icon": {
        "color": "terminal.ansiBlue",
        "id": "compass"
      },
      "presentation": {
        "echo": true,
        "reveal": "never",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true,
        "close": true
      }
    }
  ],
  "inputs": [
    {
      "id": "presetName",
      "description": "SuperCollide preset name",
      "type": "promptString",
      "default": "main"
    }
  ]
}
