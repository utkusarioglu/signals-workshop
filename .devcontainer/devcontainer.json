{
  "name": "signals-workshop.workshops.utkusarioglu.com",
  "dockerComposeFile": [
    "../.docker/docker-compose.dev.yml",
    "docker-compose.yml"
  ],
  "service": "signals-workshop",
  "workspaceFolder": "/utkusarioglu-com/workshops/signals-workshop",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "settings": {
        "remote.autoForwardPorts": false,
        "workbench.colorCustomizations": {
          "activityBar.background": "#430157",
          "activityBar.foreground": "#ffffff"
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-python.black-formatter",
        "ms-vscode.powershell",
        "tamasfe.even-better-toml",
        "salkin-mada.language-supercollider"
      ]
    }
  },
  "postCreateCommand": "scripts/post-create-command.sh"
}
